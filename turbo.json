{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**", "build/**"]
		},

		"lint": {
			"dependsOn": ["^lint"]
		},

		"typecheck": {
			"dependsOn": ["^build", "^typecheck"]
		},

		"dev": {
			"cache": false,
			"persistent": true
		},

		"test": {
			"dependsOn": ["^build"]
		}
	}
}
